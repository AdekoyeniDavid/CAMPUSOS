VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Optional: register this same reCAPTCHA Enterprise site key for the web app in Firebase App Check first.
VITE_FIREBASE_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=
# Direct Firebase Firestore transport is the default. Opt in to the Worker proxy
# only for environments where native Firestore requests are restricted.
VITE_FIRESTORE_WORKER_HOST=
VITE_USE_FIRESTORE_WORKER_PROXY=false
