rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAndVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function sessionIsActive(studentUid) {
      let controlPath = /databases/$(database)/documents/students/$(studentUid)/security/session-control;
      return !exists(controlPath)
        || request.auth.token.auth_time >= get(controlPath).data.revokedAt.seconds()
        || request.auth.token.auth_time == get(controlPath).data.exemptAuthTime;
    }

    function ownsStudent(studentUid) {
      return signedInAndVerified()
        && request.auth.uid == studentUid
        && sessionIsActive(studentUid);
    }

    function validSessionControl() {
      return request.resource.data.keys().hasOnly(['revokedAt', 'exemptAuthTime'])
        && request.resource.data.keys().hasAll(['revokedAt', 'exemptAuthTime'])
        && request.resource.data.revokedAt == request.time
        && request.resource.data.exemptAuthTime == request.auth.token.auth_time;
    }

    function isAdmin() {
      return signedInAndVerified()
        && request.auth.token.role == 'admin'
        && sessionIsActive(request.auth.uid);
    }

    function isAssignedLecturer(studentUid) {
      let student = get(/databases/$(database)/documents/students/$(studentUid)).data;
      return signedInAndVerified()
        && request.auth.token.role == 'lecturer'
        && sessionIsActive(request.auth.uid)
        && student.authorizedStaffUids is list
        && request.auth.uid in student.authorizedStaffUids;
    }

    function canReadStudent(studentUid) {
      return ownsStudent(studentUid) || isAdmin() || isAssignedLecturer(studentUid);
    }

    function validStudentDocument(studentUid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'profile', 'institution', 'personal', 'contact',
          'academic', 'enrolment', 'courses', 'progress',
          'authorizedStaffUids', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == studentUid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.profile is map
        && request.resource.data.authorizedStaffUids is list
        && request.resource.data.authorizedStaffUids.size() <= 20;
    }

    function studentEditableFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'profile', 'institution', 'personal', 'contact', 'academic',
        'enrolment', 'courses', 'progress', 'updatedAt'
      ])
      && request.resource.data.email == resource.data.email
      && request.resource.data.uid == resource.data.uid
      && request.resource.data.authorizedStaffUids == resource.data.authorizedStaffUids
      && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validAcademicPeriodFields() {
      return (!request.resource.data.keys().hasAny(['academicSession'])
          || (request.resource.data.academicSession is string
            && request.resource.data.academicSession.size() == 9
            && request.resource.data.academicSession.matches('^[0-9]{4}/[0-9]{4}$')))
        && (!request.resource.data.keys().hasAny(['semester'])
          || request.resource.data.semester in ['First semester', 'Second semester', 'Extended semester']);
    }

    function validCourse() {
      return request.resource.data.keys().hasOnly([
          'code', 'name', 'color', 'creditUnits', 'lecturerName', 'lectureVenue', 'archived', 'academicSession', 'semester', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 32
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && (!request.resource.data.keys().hasAny(['creditUnits'])
          || (request.resource.data.creditUnits is int
            && request.resource.data.creditUnits >= 1
            && request.resource.data.creditUnits <= 5))
        && (!request.resource.data.keys().hasAny(['archived'])
          || request.resource.data.archived is bool)
        && (!request.resource.data.keys().hasAny(['lecturerName'])
          || (request.resource.data.lecturerName is string && request.resource.data.lecturerName.size() <= 160))
        && (!request.resource.data.keys().hasAny(['lectureVenue'])
          || (request.resource.data.lectureVenue is string && request.resource.data.lectureVenue.size() <= 160))
        && validAcademicPeriodFields();
    }

    function validAssignment(assignmentId) {
      return request.resource.data.keys().hasOnly([
          'id', 'title', 'question', 'description', 'studentId', 'course', 'due',
          'completed', 'createdAt', 'updatedAt', 'dueDate', 'academicSession', 'semester'
        ])
        && (!('id' in request.resource.data)
          || request.resource.data.id == assignmentId)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.question is string
        && request.resource.data.question.size() <= 10000
        && (!('description' in request.resource.data)
          || (request.resource.data.description is string
            && request.resource.data.description.size() <= 10000))
        && (!('studentId' in request.resource.data)
          || (request.resource.data.studentId is string
            && request.resource.data.studentId.size() <= 80))
        && request.resource.data.course is string
        && request.resource.data.course.size() <= 32
        && request.resource.data.due is string
        && request.resource.data.due.size() > 0
        && request.resource.data.due.size() <= 80
        && (!('dueDate' in request.resource.data)
          || (request.resource.data.dueDate is string
            && request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && request.resource.data.completed is bool
        && validAcademicPeriodFields();
    }

    function validSchedule() {
      return request.resource.data.keys().hasOnly([
          'courseCode', 'day', 'start', 'end', 'createdAt', 'updatedAt', 'academicSession', 'semester'
        ])
        && request.resource.data.courseCode is string
        && request.resource.data.courseCode.size() > 0
        && request.resource.data.courseCode.size() <= 32
        && request.resource.data.day in [
          'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'
        ]
        && request.resource.data.start is string
        && request.resource.data.end is string
        && request.resource.data.start < request.resource.data.end
        && validAcademicPeriodFields();
    }

    function validExam() {
      return request.resource.data.keys().hasOnly([
          'title', 'courseCode', 'date', 'start', 'end', 'location', 'createdAt', 'updatedAt', 'academicSession', 'semester'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.courseCode is string
        && request.resource.data.courseCode.size() > 0
        && request.resource.data.courseCode.size() <= 32
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.start is string
        && request.resource.data.start.size() == 5
        && (!request.resource.data.keys().hasAny(['end'])
          || (request.resource.data.end is string
            && request.resource.data.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && request.resource.data.end > request.resource.data.start))
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 160
        && validAcademicPeriodFields();
    }

    function validEvent() {
      return request.resource.data.keys().hasOnly([
          'title', 'description', 'date', 'start', 'end', 'location', 'scheduled', 'createdAt', 'updatedAt', 'academicSession', 'semester'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && request.resource.data.scheduled is bool
        && (!request.resource.data.scheduled
          || (request.resource.data.date is string
            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.start is string
            && request.resource.data.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && request.resource.data.end is string
            && request.resource.data.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && request.resource.data.end > request.resource.data.start
            && request.resource.data.location is string
            && request.resource.data.location.size() <= 160))
        && validAcademicPeriodFields();
    }

    match /students/{studentUid} {
      allow get: if canReadStudent(studentUid);
      allow list: if isAdmin();
      allow create: if ownsStudent(studentUid) && validStudentDocument(studentUid)
        && request.resource.data.authorizedStaffUids == [];
      allow update: if (ownsStudent(studentUid) && validStudentDocument(studentUid) && studentEditableFieldsOnly())
        || isAdmin();
      allow delete: if isAdmin();

      match /security/{securityDoc} {
        // Revoked sessions can still read this control document so the client can detect
        // the revocation and clear its local Firebase session.
        allow get: if securityDoc == 'session-control'
          && signedInAndVerified()
          && request.auth.uid == studentUid;
        allow list: if false;
        allow create, update: if securityDoc == 'session-control'
          && ownsStudent(studentUid)
          && validSessionControl();
        allow delete: if false;
      }

      match /courses/{courseId} {
        allow read: if canReadStudent(studentUid);
        allow create, update: if (ownsStudent(studentUid) && validCourse()) || isAdmin();
        allow delete: if ownsStudent(studentUid) || isAdmin();
      }

      match /assignments/{assignmentId} {
        allow read: if canReadStudent(studentUid);
        allow create, update: if (ownsStudent(studentUid) && validAssignment(assignmentId)) || isAdmin();
        allow delete: if ownsStudent(studentUid) || isAdmin();
      }

      match /schedules/{scheduleId} {
        allow read: if canReadStudent(studentUid);
        allow create, update: if (ownsStudent(studentUid) && validSchedule()) || isAdmin();
        allow delete: if ownsStudent(studentUid) || isAdmin();
      }

      match /exams/{examId} {
        allow read: if canReadStudent(studentUid);
        allow create, update: if (ownsStudent(studentUid) && validExam()) || isAdmin();
        allow delete: if ownsStudent(studentUid) || isAdmin();
      }

      match /events/{eventId} {
        allow read: if canReadStudent(studentUid);
        allow create, update: if (ownsStudent(studentUid) && validEvent()) || isAdmin();
        allow delete: if ownsStudent(studentUid) || isAdmin();
      }

      match /notificationReminders/{reminderId} {
        allow read: if ownsStudent(studentUid);
        allow create, update: if ownsStudent(studentUid)
          && request.resource.data.keys().hasOnly(['sourceType', 'sourceId', 'courseCode', 'leadMinutes', 'dueDate', 'dueTime'])
          && request.resource.data.sourceType in ['weekly', 'exam', 'event', 'assignment']
          && request.resource.data.sourceId is string
          && request.resource.data.sourceId.size() > 0
          && request.resource.data.sourceId.size() <= 128
          && request.resource.data.courseCode is string
          && request.resource.data.courseCode.size() > 0
          && request.resource.data.courseCode.size() <= 100
          && ((request.resource.data.sourceType == 'assignment' && request.resource.data.leadMinutes in [5, 15, 30, 60, 1440])
            || (request.resource.data.sourceType != 'assignment' && request.resource.data.leadMinutes in [5, 15, 30, 60]))
          && (request.resource.data.sourceType != 'assignment'
            || (request.resource.data.keys().hasAll(['dueDate', 'dueTime'])
              && request.resource.data.dueDate is string
              && request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && request.resource.data.dueTime is string
              && request.resource.data.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
        allow delete: if ownsStudent(studentUid);
      }
    }
  }
}
