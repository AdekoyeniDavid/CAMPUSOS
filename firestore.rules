rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAndVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isVerifiedStudent(studentUid) {
      return signedInAndVerified() && request.auth.uid == studentUid;
    }

    function sessionIsActive(studentUid) {
      let controlPath = /databases/$(database)/documents/students/$(studentUid)/security/session-control;
      return !exists(controlPath)
        || request.auth.token.auth_time >= get(controlPath).data.revokedAt.seconds()
        || request.auth.token.auth_time == get(controlPath).data.exemptAuthTime;
    }

    function ownsStudent(studentUid) {
      return isVerifiedStudent(studentUid)
        && exists(/databases/$(database)/documents/students/$(studentUid))
        && sessionIsActive(studentUid);
    }

    function deletionRequested(studentUid) {
      return exists(/databases/$(database)/documents/students/$(studentUid)/security/account-deletion);
    }

    function canModifyStudent(studentUid) {
      return ownsStudent(studentUid) && !deletionRequested(studentUid);
    }

    function validDeletionRequest() {
      return request.resource.data.keys().hasOnly(['requestedAt'])
        && request.resource.data.keys().hasAll(['requestedAt'])
        && request.resource.data.requestedAt == request.time;
    }

    function validSessionControl() {
      return request.resource.data.keys().hasOnly(['revokedAt', 'exemptAuthTime'])
        && request.resource.data.keys().hasAll(['revokedAt', 'exemptAuthTime'])
        && request.resource.data.revokedAt == request.time
        && request.resource.data.exemptAuthTime == request.auth.token.auth_time;
    }

    function isAdmin() {
      return signedInAndVerified()
        && request.auth.token.role == 'admin'
        && sessionIsActive(request.auth.uid);
    }

    function isAssignedLecturer(studentUid) {
      let student = get(/databases/$(database)/documents/students/$(studentUid)).data;
      return signedInAndVerified()
        && request.auth.token.role == 'lecturer'
        && sessionIsActive(request.auth.uid)
        && student.authorizedStaffUids is list
        && request.auth.uid in student.authorizedStaffUids;
    }

    function canReadStudent(studentUid) {
      return ownsStudent(studentUid) || isAdmin() || isAssignedLecturer(studentUid);
    }

    function validStudentDocument(studentUid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'profile', 'institution', 'personal', 'contact',
          'academic', 'enrolment', 'courses', 'progress',
          'authorizedStaffUids', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == studentUid
        && request.resource.data.email == request.auth.token.email
        && validStudentSections(request.resource.data)
        && request.resource.data.authorizedStaffUids is list
        && request.resource.data.authorizedStaffUids.size() <= 20;
    }

    function optionalString(data, key, maxLength) {
      return !data.keys().hasAny([key])
        || (data[key] is string && data[key].size() <= maxLength);
    }

    function validProgress(progress) {
      return progress is map
        && progress.keys().hasOnly([
          'gpa', 'completedCredits', 'standing',
          'studyNotes', 'gradeRecords', 'academicSessions', 'deletedStudyRecords'
        ])
        && optionalString(progress, 'gpa', 40)
        && optionalString(progress, 'completedCredits', 40)
        && optionalString(progress, 'standing', 100)
        && (!progress.keys().hasAny(['studyNotes'])
          || (progress.studyNotes is list && progress.studyNotes.size() <= 500))
        && (!progress.keys().hasAny(['gradeRecords'])
          || (progress.gradeRecords is list && progress.gradeRecords.size() <= 1000))
        // Academic-session data is keyed by year and semester. Restrict the
        // count while Firestore's document-size limit bounds stored values.
        && (!progress.keys().hasAny(['academicSessions'])
          || (progress.academicSessions is map && progress.academicSessions.size() <= 100))
        && (!progress.keys().hasAny(['deletedStudyRecords'])
          || (progress.deletedStudyRecords is map && progress.deletedStudyRecords.size() <= 5000));
    }

    function validStudentSections(data) {
      return data.profile is map
        && data.profile.keys().hasOnly(['fullName', 'studentId', 'programme', 'photo'])
        && optionalString(data.profile, 'fullName', 160)
        && optionalString(data.profile, 'studentId', 80)
        && optionalString(data.profile, 'programme', 160)
        && optionalString(data.profile, 'photo', 2048)
        && data.institution is map
        && data.institution.keys().hasOnly(['name'])
        && optionalString(data.institution, 'name', 200)
        && data.personal is map
        && data.personal.keys().hasOnly(['dateOfBirth', 'gender', 'genderDescription', 'nationality'])
        && optionalString(data.personal, 'dateOfBirth', 10)
        && optionalString(data.personal, 'gender', 40)
        && optionalString(data.personal, 'genderDescription', 120)
        && optionalString(data.personal, 'nationality', 80)
        && data.contact is map
        && data.contact.keys().hasOnly(['email', 'phone', 'phoneCountryCode', 'address'])
        && data.contact.email == data.email
        && optionalString(data.contact, 'phone', 40)
        && optionalString(data.contact, 'phoneCountryCode', 24)
        && optionalString(data.contact, 'address', 1000)
        && data.academic is map
        && data.academic.keys().hasOnly(['department', 'programme', 'level', 'session', 'semester', 'selectionUpdatedAt', 'sessionHistory', 'programStart', 'programEnd'])
        && optionalString(data.academic, 'department', 160)
        && optionalString(data.academic, 'programme', 160)
        && optionalString(data.academic, 'level', 40)
        && optionalString(data.academic, 'session', 20)
        && optionalString(data.academic, 'semester', 40)
        && optionalString(data.academic, 'selectionUpdatedAt', 16)
        && (!data.academic.keys().hasAny(['selectionUpdatedAt']) || data.academic.selectionUpdatedAt.matches('^[0-9]{1,16}$'))
        && optionalString(data.academic, 'sessionHistory', 20000)
        && optionalString(data.academic, 'programStart', 10)
        && optionalString(data.academic, 'programEnd', 10)
        && data.enrolment is map
        && data.enrolment.keys().hasOnly(['admissionDate', 'status', 'graduation'])
        && optionalString(data.enrolment, 'admissionDate', 10)
        && optionalString(data.enrolment, 'status', 80)
        && optionalString(data.enrolment, 'graduation', 10)
        && data.courses is map
        && data.courses.keys().hasOnly(['registeredCourses'])
        && optionalString(data.courses, 'registeredCourses', 30000)
        && data.progress is map
        && validProgress(data.progress);
    }

    function studentEditableFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'profile', 'institution', 'personal', 'contact', 'academic',
        'enrolment', 'courses', 'progress', 'updatedAt'
      ])
      && request.resource.data.email == resource.data.email
      && request.resource.data.uid == resource.data.uid
      && request.resource.data.authorizedStaffUids == resource.data.authorizedStaffUids
      && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validProgressOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress', 'updatedAt'])
        && request.resource.data.progress is map
        && resource.data.progress is map
        && validChangedProgressFields();
    }

    // Validate only progress keys changed by this request. Student records
    // created by earlier CampusOS versions can contain additional legacy
    // values; those unchanged values must not block a notes/grades write.
    function validChangedProgressFields() {
      let progress = request.resource.data.progress;
      let previousProgress = resource.data.progress;
      let changed = progress.diff(previousProgress).affectedKeys();
      return changed.hasOnly([
          'gpa', 'completedCredits', 'standing',
          'studyNotes', 'gradeRecords', 'academicSessions', 'deletedStudyRecords'
        ])
        && (!changed.hasAny(['gpa']) || optionalString(progress, 'gpa', 40))
        && (!changed.hasAny(['completedCredits']) || optionalString(progress, 'completedCredits', 40))
        && (!changed.hasAny(['standing']) || optionalString(progress, 'standing', 100))
        && (!changed.hasAny(['studyNotes'])
          || !progress.keys().hasAny(['studyNotes'])
          || (progress.studyNotes is list && progress.studyNotes.size() <= 500))
        && (!changed.hasAny(['gradeRecords'])
          || !progress.keys().hasAny(['gradeRecords'])
          || (progress.gradeRecords is list && progress.gradeRecords.size() <= 1000))
        && (!changed.hasAny(['academicSessions'])
          || !progress.keys().hasAny(['academicSessions'])
          || (progress.academicSessions is map && progress.academicSessions.size() <= 100))
        && (!changed.hasAny(['deletedStudyRecords'])
          || !progress.keys().hasAny(['deletedStudyRecords'])
          || (progress.deletedStudyRecords is map && progress.deletedStudyRecords.size() <= 5000));
    }

    // Existing student documents can contain fields written by older app
    // versions. Validate only the section being changed so one stale section
    // cannot block unrelated profile, academic, or course updates forever.
    function validChangedStudentSections() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['profile'])
          || (request.resource.data.profile is map
            && request.resource.data.profile.keys().hasOnly(['fullName', 'studentId', 'programme', 'photo'])
            && optionalString(request.resource.data.profile, 'fullName', 160)
            && optionalString(request.resource.data.profile, 'studentId', 80)
            && optionalString(request.resource.data.profile, 'programme', 160)
            && optionalString(request.resource.data.profile, 'photo', 2048)))
        && (!changed.hasAny(['institution'])
          || (request.resource.data.institution is map
            && request.resource.data.institution.keys().hasOnly(['name'])
            && optionalString(request.resource.data.institution, 'name', 200)))
        && (!changed.hasAny(['personal'])
          || (request.resource.data.personal is map
            && request.resource.data.personal.keys().hasOnly(['dateOfBirth', 'gender', 'genderDescription', 'nationality'])
            && optionalString(request.resource.data.personal, 'dateOfBirth', 10)
            && optionalString(request.resource.data.personal, 'gender', 40)
            && optionalString(request.resource.data.personal, 'genderDescription', 120)
            && optionalString(request.resource.data.personal, 'nationality', 80)))
        && (!changed.hasAny(['contact'])
          || (request.resource.data.contact is map
            && request.resource.data.contact.keys().hasOnly(['email', 'phone', 'phoneCountryCode', 'address'])
            && request.resource.data.contact.email == request.resource.data.email
            && optionalString(request.resource.data.contact, 'phone', 40)
            && optionalString(request.resource.data.contact, 'phoneCountryCode', 24)
            && optionalString(request.resource.data.contact, 'address', 1000)))
        && (!changed.hasAny(['academic'])
          || (request.resource.data.academic is map
            && request.resource.data.academic.keys().hasOnly(['department', 'programme', 'level', 'session', 'semester', 'selectionUpdatedAt', 'sessionHistory', 'programStart', 'programEnd'])
            && optionalString(request.resource.data.academic, 'department', 160)
            && optionalString(request.resource.data.academic, 'programme', 160)
            && optionalString(request.resource.data.academic, 'level', 40)
            && optionalString(request.resource.data.academic, 'session', 20)
            && optionalString(request.resource.data.academic, 'semester', 40)
            && optionalString(request.resource.data.academic, 'selectionUpdatedAt', 16)
            && (!request.resource.data.academic.keys().hasAny(['selectionUpdatedAt']) || request.resource.data.academic.selectionUpdatedAt.matches('^[0-9]{1,16}$'))
            && optionalString(request.resource.data.academic, 'sessionHistory', 20000)
            && optionalString(request.resource.data.academic, 'programStart', 10)
            && optionalString(request.resource.data.academic, 'programEnd', 10)
            && (!request.resource.data.academic.keys().hasAny(['session'])
              || request.resource.data.academic.session == 'Not provided'
              || request.resource.data.academic.session.matches('^[0-9]{4}/[0-9]{4}$'))
            && (!request.resource.data.academic.keys().hasAny(['semester'])
              || request.resource.data.academic.semester in ['First semester', 'Second semester', 'Extended semester', 'Not provided'])))
        && (!changed.hasAny(['enrolment'])
          || (request.resource.data.enrolment is map
            && request.resource.data.enrolment.keys().hasOnly(['admissionDate', 'status', 'graduation'])
            && optionalString(request.resource.data.enrolment, 'admissionDate', 10)
            && optionalString(request.resource.data.enrolment, 'status', 80)
            && optionalString(request.resource.data.enrolment, 'graduation', 10)))
        && (!changed.hasAny(['courses'])
          || (request.resource.data.courses is map
            && request.resource.data.courses.keys().hasOnly(['registeredCourses'])
            && optionalString(request.resource.data.courses, 'registeredCourses', 30000)))
        && (!changed.hasAny(['progress'])
          || validChangedProgressFields());
    }

    function validAcademicPeriodFields() {
      return (!request.resource.data.keys().hasAny(['academicSession'])
          || (request.resource.data.academicSession is string
            && request.resource.data.academicSession.size() == 9
            && request.resource.data.academicSession.matches('^[0-9]{4}/[0-9]{4}$')))
        && (!request.resource.data.keys().hasAny(['semester'])
          || request.resource.data.semester in ['First semester', 'Second semester', 'Extended semester']);
    }

    function validStudyItem() {
      return request.resource.data.keys().hasOnly([
          'recordType', 'recordId', 'academicSession', 'semester', 'record', 'deleted', 'updatedAt'
        ])
        && request.resource.data.recordType in ['studyNotes', 'gradeRecords']
        && request.resource.data.recordId is string
        && request.resource.data.recordId.size() > 0
        && request.resource.data.recordId.size() <= 150
        && request.resource.data.academicSession is string
        && (request.resource.data.academicSession == 'Not provided'
          || request.resource.data.academicSession.matches('^[0-9]{4}/[0-9]{4}$'))
        && request.resource.data.semester in ['First semester', 'Second semester', 'Extended semester', 'Not provided']
        && request.resource.data.deleted is bool
        && (request.resource.data.deleted
          || (request.resource.data.record is map
            && request.resource.data.record.id == request.resource.data.recordId));
    }

    function validCourse() {
      return request.resource.data.keys().hasOnly([
          'code', 'name', 'color', 'creditUnits', 'lecturerName', 'lectureVenue', 'archived', 'academicSession', 'semester', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 32
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && (!request.resource.data.keys().hasAny(['creditUnits'])
          || (request.resource.data.creditUnits is int
            && request.resource.data.creditUnits >= 1
            && request.resource.data.creditUnits <= 5))
        && (!request.resource.data.keys().hasAny(['archived'])
          || request.resource.data.archived is bool)
        && (!request.resource.data.keys().hasAny(['lecturerName'])
          || (request.resource.data.lecturerName is string && request.resource.data.lecturerName.size() <= 160))
        && (!request.resource.data.keys().hasAny(['lectureVenue'])
          || (request.resource.data.lectureVenue is string && request.resource.data.lectureVenue.size() <= 160))
        && validAcademicPeriodFields();
    }

    function validAssignment(assignmentId) {
      return request.resource.data.keys().hasOnly([
          'id', 'title', 'question', 'description', 'studentId', 'course', 'due',
          'completed', 'createdAt', 'updatedAt', 'dueDate', 'academicSession', 'semester'
        ])
        && (!('id' in request.resource.data)
          || request.resource.data.id == assignmentId)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.question is string
        && request.resource.data.question.size() <= 10000
        && (!('description' in request.resource.data)
          || (request.resource.data.description is string
            && request.resource.data.description.size() <= 10000))
        && (!('studentId' in request.resource.data)
          || (request.resource.data.studentId is string
            && request.resource.data.studentId.size() <= 80))
        && request.resource.data.course is string
        && request.resource.data.course.size() <= 32
        && request.resource.data.due is string
        && request.resource.data.due.size() > 0
        && request.resource.data.due.size() <= 80
        && (!('dueDate' in request.resource.data)
          || (request.resource.data.dueDate is string
            && request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && request.resource.data.completed is bool
        && validAcademicPeriodFields();
    }

    function validSchedule() {
      return request.resource.data.keys().hasOnly([
          'courseCode', 'courseName', 'day', 'start', 'end', 'createdAt', 'updatedAt', 'academicSession', 'semester'
        ])
        && request.resource.data.courseCode is string
        && request.resource.data.courseCode.size() > 0
        && request.resource.data.courseCode.size() <= 32
        && (!('courseName' in request.resource.data)
          || (request.resource.data.courseName is string
            && request.resource.data.courseName.size() <= 160))
        && request.resource.data.day in [
          'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'
        ]
        && request.resource.data.start is string
        && request.resource.data.end is string
        && request.resource.data.start < request.resource.data.end
        && validAcademicPeriodFields();
    }

    function validExam() {
      return request.resource.data.keys().hasOnly([
          'title', 'courseCode', 'date', 'start', 'end', 'location', 'createdAt', 'updatedAt', 'academicSession', 'semester'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.courseCode is string
        && request.resource.data.courseCode.size() > 0
        && request.resource.data.courseCode.size() <= 32
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.start is string
        && request.resource.data.start.size() == 5
        && (!request.resource.data.keys().hasAny(['end'])
          || (request.resource.data.end is string
            && request.resource.data.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && request.resource.data.end > request.resource.data.start))
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 160
        && validAcademicPeriodFields();
    }

    function validEvent() {
      return request.resource.data.keys().hasOnly([
          'title', 'description', 'date', 'start', 'end', 'location', 'scheduled', 'createdAt', 'updatedAt', 'academicSession', 'semester'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && request.resource.data.scheduled is bool
        && (!request.resource.data.scheduled
          || (request.resource.data.date is string
            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.start is string
            && request.resource.data.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && request.resource.data.end is string
            && request.resource.data.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && request.resource.data.end > request.resource.data.start
            && request.resource.data.location is string
            && request.resource.data.location.size() <= 160))
        && validAcademicPeriodFields();
    }

    match /students/{studentUid} {
      allow get: if canReadStudent(studentUid);
      allow list: if isAdmin();
      allow create: if isVerifiedStudent(studentUid) && validStudentDocument(studentUid)
        && request.resource.data.authorizedStaffUids == [];
      allow update: if (canModifyStudent(studentUid) && studentEditableFieldsOnly()
          && (validStudentDocument(studentUid) || validProgressOnlyUpdate() || validChangedStudentSections()))
        || isAdmin();
      allow delete: if (isAdmin() || (ownsStudent(studentUid) && deletionRequested(studentUid)));

      match /security/{securityDoc} {
        // Revoked sessions can still read this control document so the client can detect
        // the revocation and clear its local Firebase session.
        allow get: if securityDoc == 'session-control'
          && signedInAndVerified()
          && request.auth.uid == studentUid;
        allow list: if false;
        allow create, update: if securityDoc == 'session-control'
          && canModifyStudent(studentUid)
          && validSessionControl();
        allow create, update: if securityDoc == 'account-deletion'
          && ownsStudent(studentUid)
          && validDeletionRequest();
        allow delete: if (securityDoc == 'session-control'
            && ownsStudent(studentUid)
            && deletionRequested(studentUid))
          || (securityDoc == 'account-deletion'
            && isVerifiedStudent(studentUid)
            && !exists(/databases/$(database)/documents/students/$(studentUid)));
      }

      match /courses/{courseId} {
        allow read: if canReadStudent(studentUid);
        allow create, update: if (canModifyStudent(studentUid) && validCourse()) || isAdmin();
        allow delete: if ownsStudent(studentUid) || isAdmin();
      }

      match /assignments/{assignmentId} {
        allow read: if canReadStudent(studentUid);
        allow create, update: if (canModifyStudent(studentUid) && validAssignment(assignmentId)) || isAdmin();
        allow delete: if ownsStudent(studentUid) || isAdmin();
      }

      match /schedules/{scheduleId} {
        allow read: if canReadStudent(studentUid);
        allow create, update: if (canModifyStudent(studentUid) && validSchedule()) || isAdmin();
        allow delete: if ownsStudent(studentUid) || isAdmin();
      }

      match /exams/{examId} {
        allow read: if canReadStudent(studentUid);
        allow create, update: if (canModifyStudent(studentUid) && validExam()) || isAdmin();
        allow delete: if ownsStudent(studentUid) || isAdmin();
      }

      match /events/{eventId} {
        allow read: if canReadStudent(studentUid);
        allow create, update: if (canModifyStudent(studentUid) && validEvent()) || isAdmin();
        allow delete: if ownsStudent(studentUid) || isAdmin();
      }

      match /studyItems/{studyItemId} {
        allow read: if canReadStudent(studentUid);
        allow create, update: if (canModifyStudent(studentUid) && validStudyItem()) || isAdmin();
        allow delete: if ownsStudent(studentUid) || isAdmin();
      }

      match /notificationReminders/{reminderId} {
        allow read: if ownsStudent(studentUid);
        allow create, update: if canModifyStudent(studentUid)
          && request.resource.data.keys().hasOnly(['sourceType', 'sourceId', 'courseCode', 'leadMinutes', 'dueDate', 'dueTime'])
          && request.resource.data.sourceType in ['weekly', 'exam', 'event', 'assignment']
          && request.resource.data.sourceId is string
          && request.resource.data.sourceId.size() > 0
          && request.resource.data.sourceId.size() <= 128
          && request.resource.data.courseCode is string
          && request.resource.data.courseCode.size() > 0
          && request.resource.data.courseCode.size() <= 100
          && ((request.resource.data.sourceType == 'assignment' && request.resource.data.leadMinutes in [5, 15, 30, 60, 1440])
            || (request.resource.data.sourceType != 'assignment' && request.resource.data.leadMinutes in [5, 15, 30, 60]))
          && (request.resource.data.sourceType != 'assignment'
            || (request.resource.data.keys().hasAll(['dueDate', 'dueTime'])
              && request.resource.data.dueDate is string
              && request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && request.resource.data.dueTime is string
              && request.resource.data.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
        allow delete: if ownsStudent(studentUid);
      }
    }
  }
}
