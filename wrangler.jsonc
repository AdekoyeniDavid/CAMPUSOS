{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campusos",
  "main": "workers/index.js",
  "compatibility_date": "2026-10-23",
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/google.firestore.v1.Firestore/*"]
  },
  "observability": {
    "enabled": true
  }
}
